# Origem pública e cliente OAuth Google.
PUBLIC_URL=http://127.0.0.1:4173
GOOGLE_CALLBACK_URL=http://127.0.0.1:4173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker Compose: senhas geradas por npm run docker:setup, com caracteres seguros para URL.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
APP_PORT=4173
# Execução por npm start ou compose.remote.yaml: URL do PostgreSQL externo.
# Exemplo: postgresql://hunter_runtime:senha@db.example.invalid:5432/hunter?sslmode=verify-full
DATABASE_URL=
HOST=127.0.0.1
PORT=4173
SESSION_SECONDS=28800
MAX_BODY_BYTES=1048576
# IPs exatos do proxy diretamente conectado. Vazio utiliza o IP da conexão.
TRUSTED_PROXY_IPS=
# Limites por minuto. O limite de IP da API equivale a 5 vezes o limite por usuário.
RATE_AUTH_START=20
RATE_AUTH_CALLBACK=40
RATE_READ=300
RATE_SAVE=120
RATE_MUTATION=30
